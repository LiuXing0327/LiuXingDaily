<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.流星日记"
        android:usesCleartextTraffic="true"
        tools:targetApi="33" >
        <activity
            android:label="@string/wallpaper"
            android:name=".ui.wallpaper.WallpaperActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.DailySettingsActivity"
            android:exported="false" />
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false" />
        <activity
            android:name=".ui.datamanagement.DataManagementActivity"
            android:exported="false"
            android:label="@string/data_management"
            android:theme="@style/Theme.流星日记" />
        <activity
            android:name=".ui.about.OpenSourceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.privacy.PrivacyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.draw.DrawImageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lock.UnlockActivity"
            android:exported="false" />
        <activity
            android:name=".ui.webdav.WebDavBackupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.appearance.AppearanceSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.audio.PlayAudioActivity"
            android:exported="false" />
        <activity
            android:name=".ui.video.LookDailyVideoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.label.DailyLabelActivity"
            android:exported="false" />
        <activity
            android:name=".ui.gallery.LookGalleryImageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.image.LookDailyImageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.about.SpecialThanksActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings" />
        <activity
            android:name=".ui.look.LookDailyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.updatelog.UpdateLogActivity"
            android:exported="false" />
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.edit.EditDailyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.add.AddDailyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
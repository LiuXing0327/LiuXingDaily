<resources xmlns:tools="http://schemas.android.com/tools" xmlns:ns1="http://schemas.android.com/apk/res-auto">

    <style name="Widget.Theme.流星日记.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.流星日记.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="Widget.Theme.流星日记.Toolbar.WithCloseButton" parent="Widget.MaterialComponents.Toolbar">
        <item name="navigationContentDescription">@string/close</item>
        <item name="navigationIcon">@drawable/baseline_toolbar_close_24</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">?attr/colorPrimary</item>
    </style>

    <style name="Widget.流星日记.Material3Expressive.Button" parent="Widget.Material3Expressive.Button">
        <item name="shapeAppearance">@xml/daily_m3expressive_button_shape_state_list</item>
    </style>
    <style name="Widget.流星日记.Material3Expressive.Button.IconButton" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="shapeAppearance">@xml/daily_m3expressive_button_shape_state_list</item>
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium</item>
    </style>

    <style name="Widget.流星日记.Material3Expressive.Button.IconButtonFilledTonal" parent="Widget.Material3Expressive.Button.IconButton.Tonal">
        <item name="rippleColor" tools:ignore="PrivateResource">@color/m3_tonal_button_ripple_color_selector</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button.IconButton.Filled.Tonal</item>
    </style>
</resources>
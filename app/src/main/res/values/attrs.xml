<resources>
    <declare-styleable name="FullscreenAttrs">
        <attr name="fullscreenBackgroundColor" format="color" />
        <attr name="fullscreenTextColor" format="color" />
    </declare-styleable>
    <attr name="toolbarWithCloseButtonStyle" format="reference" />

    <declare-styleable name="DailyMaterialSwitch">
        <!-- 切换开关图标 -->
        <attr name="toggle_switch_icon" format="boolean" />

        <!-- 已勾选图标 -->
        <attr name="checked_icon" format="reference" />

        <!-- 未勾选图标 -->
        <attr name="unchecked_icon" format="reference" />

        <!-- 固定图标（不随选中状态变化） -->
        <attr name="static_icon" format="reference" />
    </declare-styleable>

    <attr name="layout_overflowIconTint" format="color|reference" />
    <declare-styleable name="CustomOverflowLinearLayout_Layout">
        <attr name="layout_overflowIconTint"/>
    </declare-styleable>
</resources>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/about">

        <Preference
            app:iconSpaceReserved="false"
            app:key="about_preference"
            app:title="@string/about" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="special_thanks_preference"
            app:title="@string/special_thanks" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/update">

        <Preference
            app:iconSpaceReserved="false"
            app:key="check_update_preference"
            app:title="@string/check_update" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="update_log_preference"
            app:title="@string/update_log" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/daily">

        <com.liuxing.daily.view.CustomYearMonthSwitchPreference />

        <com.liuxing.daily.view.CustomAutoSaveDailySwitchPreference />

        <com.liuxing.daily.view.CustomDeleteToRecyclerBinSwitchPreference />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/ui">

        <Preference
            app:iconSpaceReserved="false"
            app:key="theme_mode_preference"
            app:summary="跟随系统"
            app:title="@string/theme_mode" />

    </PreferenceCategory>

</PreferenceScreen>